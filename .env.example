# Պատճենեք այս ֆայլը որպես .env և լրացրեք ձեր տվյալները։
# .env-ը git-ի մեջ չի գնում։

APP_NAME=Creatorly
DEBUG=true
HOST=127.0.0.1
PORT=8000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# Եթե գաղտնաբառում կան # $ " ' կամ բացատ, գրեք միակի չակերտներում՝ DB_PASSWORD='p@ss:w#rd'
DB_PASSWORD=
DB_NAME=creatorly

# Instagram token-ների գաղտնագրման բանալի (Fernet)։ Ստեղծելու համար՝
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
