# Պատճենեք այս ֆայլը որպես .env և լրացրեք ձեր տվյալները։
# .env-ը git-ի մեջ չի գնում։

APP_NAME=Creatorly
DEBUG=true
HOST=127.0.0.1
PORT=8000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# Եթե գաղտնաբառում կան # $ " ' կամ բացատ, գրեք միակի չակերտներում՝ DB_PASSWORD='p@ss:w#rd'
DB_PASSWORD=
DB_NAME=creatorly

# Instagram token-ների գաղտնագրման բանալի (Fernet)։ Ստեղծելու համար՝
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Instagram Graph API. true = մրցակիցներին ավելացնելիս և sync-ի ժամանակ դիմել Business Discovery-ին
# (պետք է իրական token, Meta App Review-ից հետո)
INSTAGRAM_SYNC=false
GRAPH_API_VERSION=v27.0

# Instagram API with Unified login (սեփական հաշվի միացում + insights)։
# App ID / Secret՝ developers.facebook.com → App settings → Basic։ Secret-ը ոչ մեկին մի ուղարկեք։
# Config ID՝ Use cases → API setup with Unified login (պետք է instagram_basic + instagram_manage_insights)։
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
# Լոկալ թեստ առանց OAuth-ի (scripts/instagram_local.py)՝ dashboard-ում ստեղծված token
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/auth/instagram/callback
